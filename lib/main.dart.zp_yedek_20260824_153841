      sekilYildiz = veri.sekilBirlestir.toplamYildiz;
      refleksYildiz = veri.refleks.toplamYildiz;

      gunlukVeri = daily;
      oyuncuVeri = player;
      yukleniyor = false;
    });

    unawaited(
      _online.syncCurrentPlayer(player),
    );

    unawaited(
      _analytics.setPlayerProperties(
        level: player.level,
        league: player.league.shortName,
        language: AppLanguageController.instance
            .resolvedLocale.languageCode,
      ),
    );
  }

