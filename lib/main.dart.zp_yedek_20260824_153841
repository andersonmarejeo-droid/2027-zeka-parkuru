  void altMenuSec(int index) {
    if (index == 0) {
      return;
    }

    if (index == 1) {
      gunlukGorevleriAc();
      return;
    }

    if (index == 2) {
      liderligiAc();
      return;
    }

    if (index == 3) {
      profiliAc();
    }
  }

  Future<void> oyunuAc(
      int oyun,
      ) async {
    // Navigasyonu sesin tamamlanmasına bağlamıyoruz.
    // Ses asset'i olmasa bile oyun anında açılır.
    unawaited(
      _audio.play(GameSound.uiClick),
    );
    unawaited(
      _audio.play(
        GameSound.transition,
        gain: 0.62,
      ),
    );

    Widget? sayfa;

    final String? gameId = switch (oyun) {
      1 => 'logic',
      2 => 'numbers',
      3 => 'blocks',
      4 => 'memory',
      5 => 'hanoi',
      6 => 'word_hunt',
      7 => 'picture_iq',
      8 => 'candy_sort',
      9 => 'number_sort',
      10 => 'shape_puzzle',
      11 => 'reflex',
      _ => null,
    };

    if (gameId != null) {
      unawaited(
        _analytics.logGameOpen(gameId),
      );
    }

    if (oyun == 1) {
      sayfa =
      const LogicGamePage();
    }

    if (oyun == 2) {
      sayfa =
      const NumberGamePage();
    }

    if (oyun == 3) {
      sayfa =
      const BlockGamePage();
    }

    if (oyun == 4) {
      sayfa =
      const MemoryGamePage();
    }

    if (oyun == 5) {
      sayfa =
      const HanoiGamePage();
    }

    if (oyun == 6) {
      sayfa = const WordHuntGamePage();
    }

    if (oyun == 7) {
      sayfa = const PictureIqGamePage();
    }

    if (oyun == 8) {
      sayfa = const CandySortGamePage();
    }

    if (oyun == 9) {
      sayfa = const NumberSortGamePage();
    }

    if (oyun == 10) {
      sayfa = const ShapePuzzleGamePage();
    }

    if (oyun == 11) {
      sayfa = const ReflexGamePage();
    }

    if (sayfa != null) {
      await Navigator.push(
        context,
        MaterialPageRoute(
          builder: (context) =>
          sayfa!,
        ),
      );

      await anaSayfayiYenile();

      return;
    }

    if (!mounted) return;

    ScaffoldMessenger.of(context)
        .showSnackBar(
      SnackBar(
        behavior:
        SnackBarBehavior.floating,
        content: Text(
          context.l10n.courseUnavailable,
        ),
      ),
    );
  }

