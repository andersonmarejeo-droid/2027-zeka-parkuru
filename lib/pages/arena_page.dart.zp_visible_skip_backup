int _groupIdentityIndex(ArenaGroup group) {
  final String source = '${group.id}|${group.name}|${group.joinCode}';
  return source.codeUnits.fold<int>(
        0,
        (int value, int unit) => (value * 31 + unit) & 0x7fffffff,
      ) %
      6;
}

