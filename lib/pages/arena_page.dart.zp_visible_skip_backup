class ArenaPage extends StatefulWidget {
  final String? initialGroupId;
  final String? initialJoinCode;

  const ArenaPage({super.key, this.initialGroupId, this.initialJoinCode});

  @override
  State<ArenaPage> createState() => _ArenaPageState();
}

class _ArenaPageState extends State<ArenaPage> {
  final ArenaService _arena = ArenaService.instance;
  final OnlineLeaderboardService _leaderboard =
      OnlineLeaderboardService.instance;
  final PlayerProgressService _player = PlayerProgressService.instance;

  Stream<List<ArenaGroup>>? _groups;
  bool _loading = true;
  bool _online = false;
  bool _busy = false;
  bool _inviteHandled = false;
  String? _offlineReason;

  @override
  void initState() {
    super.initState();
    _initialize();
  }

  Future<void> _initialize({bool forceRetry = false}) async {
    final bool online = await _arena.ensureOnline(forceRetry: forceRetry);
    if (online) {
      final PlayerDashboardData dashboard = await _player.load();
      await _leaderboard.syncCurrentPlayer(dashboard);
    }
    if (!mounted) return;
    setState(() {
      _online = online;
      _offlineReason = online ? null : _arena.lastError;
      _groups = online ? _arena.watchMyGroups() : null;
      _loading = false;
    });
    unawaited(_handleInitialInvite());
  }

  Future<void> _handleInitialInvite() async {
    if (_inviteHandled || !_online) return;
    final String? groupId = widget.initialGroupId;
    final String? code = widget.initialJoinCode;
    if (groupId == null ||
        groupId.trim().isEmpty ||
        code == null ||
        code.trim().isEmpty) {
      return;
    }
    _inviteHandled = true;
    final ArenaGroup? group = await _arena.joinByInvite(
      groupId: groupId,
      joinCode: code,
    );
    if (!mounted) return;
    if (group == null) {
      _message('Grup daveti geçersiz, dolu veya süresi geçmiş olabilir.');
      return;
    }
    await _openGroup(group);
  }

  void _message(String text) {
    if (!mounted) return;
    ScaffoldMessenger.of(context)
      ..hideCurrentSnackBar()
      ..showSnackBar(
        SnackBar(behavior: SnackBarBehavior.floating, content: Text(text)),
      );
  }

  Future<void> _createGroup() async {
    if (_busy) return;
    String draftName = '';
    final String? name = await showDialog<String>(
      context: context,
      builder: (BuildContext dialogContext) => AlertDialog(
        backgroundColor: const Color(0xFF10274B),
        title: const Text('YENİ GRUP OLUŞTUR'),
        content: TextField(
          autofocus: true,
          maxLength: 40,
          textCapitalization: TextCapitalization.words,
          textInputAction: TextInputAction.done,
          onChanged: (String value) => draftName = value,
          onSubmitted: (String value) => Navigator.pop(dialogContext, value),
          decoration: const InputDecoration(
            labelText: 'Grup adı',
            hintText: 'Örn. Giresun Zekâ Takımı',
            border: OutlineInputBorder(),
          ),
        ),
        actions: <Widget>[
          TextButton(
            onPressed: () => Navigator.pop(dialogContext),
            child: const Text('VAZGEÇ'),
          ),
          FilledButton(
            onPressed: () => Navigator.pop(dialogContext, draftName),
            child: const Text('OLUŞTUR'),
          ),
        ],
      ),
    );
    if (name == null) return;

    setState(() => _busy = true);
    try {
      final ArenaGroup? group = await _arena.createGroup(name);
      if (!mounted) return;
      if (group == null) {
        _message('Grup oluşturulamadı. Bağlantını kontrol et.');
        return;
      }
      await _openGroup(group);
    } finally {
      if (mounted) setState(() => _busy = false);
    }
  }

  Future<void> _joinGroup() async {
    if (_busy) return;
    String draftCode = '';
    final String? code = await showDialog<String>(
      context: context,
      builder: (BuildContext dialogContext) => AlertDialog(
        backgroundColor: const Color(0xFF10274B),
        title: const Text('GRUBA KATIL'),
        content: TextField(
          autofocus: true,
          maxLength: 6,
          textCapitalization: TextCapitalization.characters,
          textInputAction: TextInputAction.done,
          autocorrect: false,
          enableSuggestions: false,
          inputFormatters: <TextInputFormatter>[
            FilteringTextInputFormatter.allow(RegExp('[a-zA-Z0-9]')),
          ],
          onChanged: (String value) => draftCode = value,
          onSubmitted: (String value) => Navigator.pop(dialogContext, value),
          decoration: const InputDecoration(
            labelText: '6 karakterli grup kodu',
            hintText: 'ABC123',
            border: OutlineInputBorder(),
          ),
        ),
        actions: <Widget>[
          TextButton(
            onPressed: () => Navigator.pop(dialogContext),
            child: const Text('VAZGEÇ'),
          ),
          FilledButton(
            onPressed: () => Navigator.pop(dialogContext, draftCode),
            child: const Text('KATIL'),
          ),
        ],
      ),
    );
    if (code == null || code.trim().isEmpty) return;

    setState(() => _busy = true);
    try {
      final ArenaGroup? group = await _arena.joinByCode(code);
      if (!mounted) return;
      if (group == null) {
        _message('Grup bulunamadı veya grup 30 kişiye ulaşmış.');
        return;
      }
      await _openGroup(group);
    } finally {
      if (mounted) setState(() => _busy = false);
    }
  }

  Future<void> _openGroup(ArenaGroup group) async {
    await Navigator.push<void>(
      context,
      MaterialPageRoute<void>(
        builder: (_) => ArenaGroupPage(groupId: group.id),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFF07162E),
      appBar: AppBar(
        backgroundColor: Colors.transparent,
        title: const Text(
          'ZEKÂ ARENASI',
          style: TextStyle(fontWeight: FontWeight.w900),
        ),
        actions: <Widget>[
          IconButton(
            tooltip: 'Yenile',
            onPressed: _busy ? null : () => _initialize(forceRetry: true),
            icon: const Icon(Icons.refresh_rounded),
          ),
        ],
      ),
      body: _loading
          ? const Center(child: CircularProgressIndicator())
          : !_online
          ? _ArenaOffline(
              reason: _offlineReason,
              onRetry: () => _initialize(forceRetry: true),
            )
          : RefreshIndicator(
              onRefresh: _initialize,
              child: ListView(
                physics: const AlwaysScrollableScrollPhysics(),
                padding: const EdgeInsets.fromLTRB(16, 8, 16, 32),
                children: <Widget>[
                  const _ArenaHero(),
                  const SizedBox(height: 14),
                  _ArenaActionCard(
                    icon: Icons.bolt_rounded,
                    color: const Color(0xFFFF5A3C),
                    title: '1’E 1 DÜELLO',
                    subtitle:
                        'Arkadaşına veya dünyadan bir oyuncuya '
                        'meydan oku.',
                    trailing: 'AÇ',
                    onTap: () => Navigator.push<void>(
                      context,
                      MaterialPageRoute<void>(
                        builder: (_) => const ChallengeCenterPage(),
                      ),
                    ),
                  ),
                  const SizedBox(height: 14),
                  Row(
                    children: <Widget>[
                      Expanded(
                        child: FilledButton.icon(
                          onPressed: _busy ? null : _createGroup,
                          icon: const Icon(Icons.group_add_rounded),
                          label: const Text('GRUP OLUŞTUR'),
                          style: FilledButton.styleFrom(
                            minimumSize: const Size.fromHeight(54),
                            backgroundColor: const Color(0xFF6C4DFF),
                          ),
                        ),
                      ),
                      const SizedBox(width: 10),
                      Expanded(
                        child: OutlinedButton.icon(
                          onPressed: _busy ? null : _joinGroup,
                          icon: const Icon(Icons.login_rounded),
                          label: const Text('KODLA KATIL'),
                          style: OutlinedButton.styleFrom(
                            minimumSize: const Size.fromHeight(54),
                          ),
                        ),
                      ),
                    ],
                  ),
                  const SizedBox(height: 24),
                  const _ArenaSectionTitle(
                    icon: Icons.groups_rounded,
                    title: 'GRUPLARIM',
                  ),
                  const SizedBox(height: 9),
                  StreamBuilder<List<ArenaGroup>>(
                    stream: _groups,
                    builder:
                        (
                          BuildContext context,
                          AsyncSnapshot<List<ArenaGroup>> snapshot,
                        ) {
                          if (snapshot.hasError) {
                            return _ArenaInfo(
                              text: 'Gruplar yüklenemedi: ${snapshot.error}',
                            );
                          }
                          final List<ArenaGroup> groups =
                              snapshot.data ?? const <ArenaGroup>[];
                          if (groups.isEmpty) {
                            return const _ArenaInfo(
                              text:
                                  'Henüz bir grubun yok. Grup oluştur veya '
                                  'WhatsApp’tan gelen 6 karakterli kodla katıl.',
                            );
                          }
                          return Column(
                            children: groups
                                .map(
                                  (ArenaGroup group) => Padding(
                                    padding: const EdgeInsets.only(bottom: 10),
                                    child: _GroupCard(
                                      group: group,
                                      currentUid: _arena.currentUid,
                                      onTap: () => _openGroup(group),
                                    ),
                                  ),
                                )
                                .toList(growable: false),
                          );
                        },
                  ),
                ],
              ),
            ),
    );
  }
}

class ArenaGroupPage extends StatefulWidget {
  final String groupId;

  const ArenaGroupPage({super.key, required this.groupId});

  @override
  State<ArenaGroupPage> createState() => _ArenaGroupPageState();
}

class _ArenaGroupPageState extends State<ArenaGroupPage> {
  final ArenaService _arena = ArenaService.instance;
  final OnlineLeaderboardService _leaderboard =
      OnlineLeaderboardService.instance;
  bool _busy = false;

  void _message(String text) {
    if (!mounted) return;
    ScaffoldMessenger.of(context)
      ..hideCurrentSnackBar()
      ..showSnackBar(SnackBar(content: Text(text)));
  }

  Future<void> _share(ArenaGroup group) async {
    await SharePlus.instance.share(
      ShareParams(
        subject: '${group.name} • Zekâ Parkuru grup daveti',
        text:
            '${group.name} grubunda benimle yarış!\n'
            'Grup kodu: ${group.joinCode}\n'
            '${_arena.inviteUrl(group)}',
      ),
    );
  }

  Future<void> _createEvent(ArenaGroup group) async {
    if (_busy || group.memberIds.length < 2) {
      _message('Yarışma başlatmak için grupta en az 2 kişi olmalı.');
      return;
    }
    final _ArenaCreation? creation = await showDialog<_ArenaCreation>(
      context: context,
      builder: (_) => const _CreateArenaEventDialog(),
    );
    if (creation == null) return;
    setState(() => _busy = true);
    try {
      final ArenaEvent? event = await _arena.createEvent(
        group: group,
        rawTitle: creation.title,
        selectedGameIds: creation.gameIds,
      );
      if (!mounted) return;
      if (event == null) {
        _message(
          'Yarışma oluşturulamadı. Grup üyelerini ve bağlantıyı kontrol et.',
        );
        return;
      }
      await Navigator.push<void>(
        context,
        MaterialPageRoute<void>(
          builder: (_) => ArenaEventPage(group: group, initialEvent: event),
        ),
      );
    } finally {
      if (mounted) setState(() => _busy = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    return StreamBuilder<ArenaGroup?>(
      stream: _arena.watchGroup(widget.groupId),
      builder: (BuildContext context, AsyncSnapshot<ArenaGroup?> snapshot) {
        final ArenaGroup? group = snapshot.data;
        return Scaffold(
          backgroundColor: const Color(0xFF07162E),
          appBar: AppBar(
            backgroundColor: Colors.transparent,
            title: Text(
              group?.name.toUpperCase() ?? 'GRUP YÜKLENİYOR',
              style: const TextStyle(fontWeight: FontWeight.w900, fontSize: 17),
            ),
            actions: <Widget>[
              if (group != null)
                IconButton(
                  tooltip: 'WhatsApp veya başka bir uygulamayla paylaş',
                  onPressed: () => _share(group),
                  icon: const Icon(Icons.share_rounded),
                ),
            ],
          ),
          body: group == null
              ? snapshot.hasError
                    ? Center(child: Text('Grup yüklenemedi: ${snapshot.error}'))
                    : const Center(child: CircularProgressIndicator())
              : ListView(
                  padding: const EdgeInsets.fromLTRB(16, 8, 16, 32),
                  children: <Widget>[
                    _GroupHero(
                      group: group,
                      onCopy: () async {
                        await Clipboard.setData(
                          ClipboardData(text: group.joinCode),
                        );
                        _message('Grup kodu kopyalandı.');
                      },
                      onShare: () => _share(group),
                    ),
                    const SizedBox(height: 16),
                    if (group.isOwner(_arena.currentUid))
                      FilledButton.icon(
                        onPressed: _busy ? null : () => _createEvent(group),
                        icon: const Icon(Icons.emoji_events_rounded),
                        label: const Text('YENİ YARIŞMA BAŞLAT'),
                        style: FilledButton.styleFrom(
                          minimumSize: const Size.fromHeight(56),
                          backgroundColor: const Color(0xFFFF8A3D),
                          foregroundColor: const Color(0xFF07162E),
                          textStyle: const TextStyle(
                            fontWeight: FontWeight.w900,
                          ),
                        ),
                      ),
                    const SizedBox(height: 18),
                    const _ArenaSectionTitle(
                      icon: Icons.groups_2_rounded,
                      title: 'GRUP ÜYELERİ',
                    ),
                    const SizedBox(height: 8),
                    FutureBuilder<List<OnlineLeaderboardEntry>>(
                      future: _leaderboard.fetchPlayersByUid(group.memberIds),
                      builder:
                          (
                            BuildContext context,
                            AsyncSnapshot<List<OnlineLeaderboardEntry>>
                            profileSnapshot,
                          ) {
                            final Map<String, OnlineLeaderboardEntry> profiles =
                                <String, OnlineLeaderboardEntry>{
                                  for (final OnlineLeaderboardEntry player
                                      in profileSnapshot.data ??
                                          const <OnlineLeaderboardEntry>[])
                                    player.uid: player,
                                };
                            return Wrap(
                              spacing: 8,
                              runSpacing: 8,
                              children: group.memberIds
                                  .map((String uid) {
                                    final OnlineLeaderboardEntry? player =
                                        profiles[uid];
                                    return Chip(
                                      avatar: Text(player?.avatar ?? '🧠'),
                                      label: Text(
                                        player?.displayName ??
                                            (uid == _arena.currentUid
                                                ? 'Sen'
                                                : 'Oyuncu'),
                                      ),
                                      side: BorderSide(
                                        color: uid == group.ownerUid
                                            ? const Color(0xFFFFD93D)
                                            : Colors.white12,
                                      ),
                                    );
                                  })
                                  .toList(growable: false),
                            );
                          },
                    ),
                    const SizedBox(height: 22),
                    const _ArenaSectionTitle(
                      icon: Icons.calendar_view_week_rounded,
                      title: 'HAFTALIK GRUP LİGİ',
                    ),
                    const SizedBox(height: 8),
                    StreamBuilder<List<ArenaAttempt>>(
                      stream: _arena.watchGroupAttempts(group.id),
                      builder:
                          (
                            BuildContext context,
                            AsyncSnapshot<List<ArenaAttempt>> attemptSnapshot,
                          ) {
                            return FutureBuilder<List<OnlineLeaderboardEntry>>(
                              future: _leaderboard.fetchPlayersByUid(
                                group.memberIds,
                              ),
                              builder:
                                  (
                                    BuildContext context,
                                    AsyncSnapshot<List<OnlineLeaderboardEntry>>
                                    profileSnapshot,
                                  ) {
                                    final List<ArenaWeeklyStanding> standings =
                                        _arena.buildWeeklyStandings(
                                          attempts:
                                              attemptSnapshot.data ??
                                              const <ArenaAttempt>[],
                                          profiles:
                                              profileSnapshot.data ??
                                              const <OnlineLeaderboardEntry>[],
                                        );
                                    return _WeeklyLeagueCard(
                                      standings: standings,
                                      currentUid: _arena.currentUid ?? '',
                                    );
                                  },
                            );
                          },
                    ),
                    const SizedBox(height: 22),
                    const _ArenaSectionTitle(
                      icon: Icons.military_tech_rounded,
                      title: 'YARIŞMALAR',
                    ),
                    const SizedBox(height: 8),
                    StreamBuilder<List<ArenaEvent>>(
                      stream: _arena.watchGroupEvents(group.id),
                      builder:
                          (
                            BuildContext context,
                            AsyncSnapshot<List<ArenaEvent>> eventSnapshot,
                          ) {
                            if (eventSnapshot.hasError) {
                              return _ArenaInfo(
                                text:
                                    'Yarışmalar yüklenemedi: ${eventSnapshot.error}',
                              );
                            }
                            final List<ArenaEvent> events =
                                eventSnapshot.data ?? const <ArenaEvent>[];
                            if (events.isEmpty) {
                              return const _ArenaInfo(
                                text:
                                    'Henüz yarışma yok. Grup yöneticisi tek oyun, '
                                    'seçmeli parkur veya 11 oyunluk Büyük Parkur başlatabilir.',
                              );
                            }
                            return Column(
                              children: events
                                  .map(
                                    (ArenaEvent event) => Padding(
                                      padding: const EdgeInsets.only(
                                        bottom: 10,
                                      ),
                                      child: _EventCard(
                                        event: event,
                                        onTap: () => Navigator.push<void>(
                                          context,
                                          MaterialPageRoute<void>(
                                            builder: (_) => ArenaEventPage(
                                              group: group,
                                              initialEvent: event,
                                            ),
                                          ),
                                        ),
                                      ),
                                    ),
                                  )
                                  .toList(growable: false),
                            );
                          },
                    ),
                    const SizedBox(height: 12),
                    const _ArenaInfo(
                      icon: Icons.account_tree_rounded,
                      text:
                          'İlk 8 eleme tablosu; doğrudan sıralama sistemi '
                          'sahada doğrulandıktan sonra isteğe bağlı format olarak açılacak.',
                    ),
                  ],
                ),
        );
      },
    );
  }
}

class ArenaEventPage extends StatefulWidget {
  final ArenaGroup group;
  final ArenaEvent initialEvent;

  const ArenaEventPage({
    super.key,
    required this.group,
    required this.initialEvent,
  });

  @override
  State<ArenaEventPage> createState() => _ArenaEventPageState();
}

class _ArenaEventPageState extends State<ArenaEventPage> {
  final ArenaService _arena = ArenaService.instance;
  final OnlineLeaderboardService _leaderboard =
      OnlineLeaderboardService.instance;
  late final Future<List<OnlineLeaderboardEntry>> _profiles;
  String? _playingGameId;
  bool _finishing = false;
  bool _rematching = false;
  bool _reacting = false;

  @override
  void initState() {
    super.initState();
    _profiles = _leaderboard.fetchPlayersByUid(
      widget.initialEvent.participantIds,
    );
  }

  void _message(String text) {
    if (!mounted) return;
    ScaffoldMessenger.of(context)
      ..hideCurrentSnackBar()
      ..showSnackBar(
        SnackBar(behavior: SnackBarBehavior.floating, content: Text(text)),
      );
  }

  Future<void> _sendReaction(ArenaEvent event, String reaction) async {
    if (_reacting) return;
    setState(() => _reacting = true);
    try {
      final bool sent = await _arena.sendReaction(
        event: event,
        reaction: reaction,
      );
      if (mounted) {
        _message(sent ? 'Grup mesajın gönderildi.' : 'Mesaj gönderilemedi.');
      }
    } finally {
      if (mounted) setState(() => _reacting = false);
    }
  }

  ArenaAttempt? _attemptFor(
    List<ArenaAttempt> attempts,
    String uid,
    String gameId,
  ) {
    for (final ArenaAttempt attempt in attempts) {
      if (attempt.uid == uid && attempt.gameId == gameId) return attempt;
    }
    return null;
  }

  Future<void> _playParkour(
    ArenaEvent event,
    Set<String> previouslyCompleted,
  ) async {
    if (_playingGameId != null || !event.active) return;

    final Set<String> completed = Set<String>.from(previouslyCompleted);

    try {
      for (int index = 0; index < event.gameIds.length; index++) {
        final String gameId = event.gameIds[index];
        if (completed.contains(gameId)) continue;
        if (!mounted || !event.active) return;

        setState(() => _playingGameId = gameId);

        final Object? result = await Navigator.push<Object?>(
          context,
          MaterialPageRoute<Object?>(
            builder: (_) => _ArenaSeriesGameShell(
              stationNumber: index + 1,
              totalStations: event.gameIds.length,
              gameName: _gameInfo(gameId).name,
              game: _competitionPage(event, gameId),
            ),
          ),
        );

        if (!mounted) return;

        if (result == null) {
          setState(() => _playingGameId = null);
          _message(
            'Grup parkuru ilerlemen kaydedildi. Daha sonra sıradaki '
            'oyundan devam edebilirsin.',
          );
          return;
        }

        final bool skipped = result is _ArenaSeriesSkip;
        if (!skipped && result is! DailyCourseGameResult) {
          setState(() => _playingGameId = null);
          _message('Oyun sonucu okunamadı. Kaydedilen ilerleme korunuyor.');
          return;
        }

        final DailyCourseGameResult? gameResult = skipped
            ? null
            : result as DailyCourseGameResult;
        final bool saved = await _arena.submitAttempt(
          event: event,
          gameId: gameId,
          rawScore: gameResult?.score ?? 0,
          stars: gameResult?.stars ?? 0,
        );

        if (!mounted) return;

        if (!saved) {
          setState(() => _playingGameId = null);
          _message(
            'Bu bölüm kaydedilemedi. Parkur durduruldu; kayıtlı '
            'bölümler yeniden oynatılmayacak.',
          );
          return;
        }

        completed.add(gameId);
        setState(() => _playingGameId = null);
      }

      if (mounted) {
        _message('${event.gameIds.length} oyunluk grup parkurun tamamlandı.');
      }
    } finally {
      if (mounted && _playingGameId != null) {
        setState(() => _playingGameId = null);
      }
    }
  }

  Widget _competitionPage(ArenaEvent event, String gameId) {
    final int level = event.level;
    final int layoutCode = event.layoutCodeFor(gameId);
    switch (gameId) {
      case 'logic':
        return LogicGamePage(
          competitionLevel: level,
          competitionLayoutCode: layoutCode,
        );
      case 'numbers':
        return NumberGamePage(
          competitionLevel: level,
          competitionLayoutCode: layoutCode,
        );
      case 'blocks':
        return BlockGamePage(
          competitionLevel: level,
          competitionLayoutCode: layoutCode,
        );
      case 'memory':
        return MemoryGamePage(
          competitionLevel: level,
          competitionLayoutCode: layoutCode,
        );
      case 'hanoi':
        return HanoiGamePage(
          competitionLevel: level,
          competitionLayoutCode: layoutCode,
        );
      case 'word_hunt':
        return WordHuntGamePage(
          competitionLevel: level,
          competitionLayoutCode: layoutCode,
        );
      case 'picture_iq':
        return PictureIqGamePage(
          competitionLevel: level,
          competitionLayoutCode: layoutCode,
        );
      case 'candy_sort':
        return CandySortGamePage(
          competitionLevel: level,
          competitionLayoutCode: layoutCode,
        );
      case 'number_sort':
        return NumberSortGamePage(
          competitionLevel: level,
          competitionLayoutCode: layoutCode,
        );
      case 'shape_puzzle':
        return ShapePuzzleGamePage(
          competitionLevel: level,
          competitionLayoutCode: layoutCode,
        );
      case 'reflex':
        return ReflexGamePage(
          competitionLevel: level,
          competitionLayoutCode: layoutCode,
        );
      default:
        return const Scaffold(body: Center(child: Text('Oyun bulunamadı.')));
    }
  }

  Future<void> _finish(ArenaEvent event) async {
    if (_finishing) return;
    final bool? confirm = await showDialog<bool>(
      context: context,
      builder: (BuildContext dialogContext) => AlertDialog(
        title: const Text('YARIŞMAYI BİTİR'),
        content: const Text(
          'Sıralama mevcut sonuçlarla kesinleşecek. Henüz tamamlamayanlar '
          'artık oyun oynayamayacak. Devam edilsin mi?',
        ),
        actions: <Widget>[
          TextButton(
            onPressed: () => Navigator.pop(dialogContext, false),
            child: const Text('VAZGEÇ'),
          ),
          FilledButton(
            onPressed: () => Navigator.pop(dialogContext, true),
            child: const Text('BİTİR'),
          ),
        ],
      ),
    );
    if (confirm != true) return;
    setState(() => _finishing = true);
    final bool saved = await _arena.finishEvent(event);
    if (mounted) {
      setState(() => _finishing = false);
      _message(saved ? 'Yarışma sonucu kesinleşti.' : 'Yarışma bitirilemedi.');
    }
  }

  Future<void> _shareResult(
    ArenaEvent event,
    List<ArenaStanding> standings,
  ) async {
    final StringBuffer result = StringBuffer()
      ..writeln('🏆 ${event.title} • Zekâ Parkuru Arena')
      ..writeln('${widget.group.name} grubunun kesin sonucu');
    final int podiumCount = standings.length < 3 ? standings.length : 3;
    for (int index = 0; index < podiumCount; index++) {
      final ArenaStanding item = standings[index];
      result.writeln(
        '${index + 1}. ${item.avatar} ${item.displayName} — '
        '${item.totalPoints} TP • ${item.totalStars} ⭐',
      );
    }
    result
      ..writeln()
      ..writeln('Grup kodu: ${widget.group.joinCode}')
      ..write(_arena.inviteUrl(widget.group));

    await SharePlus.instance.share(
      ShareParams(
        subject: '${event.title} • Arena sonucu',
        text: result.toString(),
      ),
    );
  }

  Future<void> _rematch(ArenaEvent event) async {
    if (_rematching) return;
    final bool? confirmed = await showDialog<bool>(
      context: context,
      builder: (BuildContext dialogContext) => AlertDialog(
        title: const Text('AYNI PARKURDA RÖVANŞ'),
        content: Text(
          '${event.gameIds.length} oyun yeni ortak düzenlerle yeniden '
          'başlatılacak. Gruptaki güncel üyeler yarışmaya eklenecek.',
        ),
        actions: <Widget>[
          TextButton(
            onPressed: () => Navigator.pop(dialogContext, false),
            child: const Text('VAZGEÇ'),
          ),
          FilledButton(
            onPressed: () => Navigator.pop(dialogContext, true),
            child: const Text('RÖVANŞI BAŞLAT'),
          ),
        ],
      ),
    );
    if (confirmed != true || !mounted) return;

    setState(() => _rematching = true);
    try {
      final ArenaGroup freshGroup =
          await _arena.getGroup(widget.group.id) ?? widget.group;
      final ArenaEvent? rematch = await _arena.createEvent(
        group: freshGroup,
        rawTitle: '${event.title} Rövanş',
        selectedGameIds: event.gameIds,
      );
      if (!mounted) return;
      if (rematch == null) {
        _message(
          'Rövanş oluşturulamadı. En az iki güncel grup üyesi ve bağlantı gerekir.',
        );
        return;
      }
      await Navigator.of(context).pushReplacement<void, void>(
        MaterialPageRoute<void>(
          builder: (_) =>
              ArenaEventPage(group: freshGroup, initialEvent: rematch),
        ),
      );
    } finally {
      if (mounted) setState(() => _rematching = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    return StreamBuilder<ArenaEvent?>(
      stream: _arena.watchEvent(widget.initialEvent.id),
      initialData: widget.initialEvent,
      builder: (BuildContext context, AsyncSnapshot<ArenaEvent?> eventSnapshot) {
        final ArenaEvent? event = eventSnapshot.data;
        if (event == null) {
          return const Scaffold(
            backgroundColor: Color(0xFF07162E),
            body: Center(child: CircularProgressIndicator()),
          );
        }
        return Scaffold(
          backgroundColor: const Color(0xFF07162E),
          appBar: AppBar(
            backgroundColor: Colors.transparent,
            title: Text(
              event.title.toUpperCase(),
              style: const TextStyle(fontWeight: FontWeight.w900, fontSize: 17),
            ),
            actions: <Widget>[
              IconButton(
                tooltip: 'Grup davetini paylaş',
                onPressed: () => SharePlus.instance.share(
                  ShareParams(
                    subject: '${widget.group.name} Zekâ Yarışı',
                    text:
                        '${widget.group.name} grubundaki ${event.title} '
                        'yarışmasına katıl!\nKod: ${widget.group.joinCode}\n'
                        '${_arena.inviteUrl(widget.group)}',
                  ),
                ),
                icon: const Icon(Icons.share_rounded),
              ),
            ],
          ),
          body: FutureBuilder<List<OnlineLeaderboardEntry>>(
            future: _profiles,
            builder:
                (
                  BuildContext context,
                  AsyncSnapshot<List<OnlineLeaderboardEntry>> profileSnapshot,
                ) {
                  return StreamBuilder<List<ArenaAttempt>>(
                    stream: _arena.watchAttempts(event.id),
                    builder:
                        (
                          BuildContext context,
                          AsyncSnapshot<List<ArenaAttempt>> attemptSnapshot,
                        ) {
                          final List<ArenaAttempt> attempts =
                              attemptSnapshot.data ?? const <ArenaAttempt>[];
                          final String currentUid = _arena.currentUid ?? '';
                          final Set<String> completedByMe = attempts
                              .where(
                                (ArenaAttempt item) => item.uid == currentUid,
                              )
                              .map((ArenaAttempt item) => item.gameId)
                              .toSet();
                          String? nextGameId;
                          for (final String gameId in event.gameIds) {
                            if (!completedByMe.contains(gameId)) {
                              nextGameId = gameId;
                              break;
                            }
                          }
                          final List<ArenaStanding> standings = _arena
                              .buildStandings(
                                event: event,
                                attempts: attempts,
                                profiles:
                                    profileSnapshot.data ??
                                    const <OnlineLeaderboardEntry>[],
                              );
                          final bool everyoneFinished =
                              standings.isNotEmpty &&
                              standings.every(
                                (ArenaStanding item) => item.finished,
                              );
                          final bool finalResult =
                              event.completed ||
                              event.expired ||
                              everyoneFinished;
                          final bool participant = event.participantIds
                              .contains(currentUid);

                          return ListView(
                            padding: const EdgeInsets.fromLTRB(16, 8, 16, 32),
                            children: <Widget>[
                              _EventHero(
                                event: event,
                                finalResult: finalResult,
                                completedByMe: completedByMe.length,
                              ),
                              const SizedBox(height: 18),
                              if (!participant) ...<Widget>[
                                const _ArenaInfo(
                                  icon: Icons.visibility_rounded,
                                  text:
                                      'Bu yarışma sen gruba katılmadan önce başladı. '
                                      'Sonuçları izleyebilirsin; bir sonraki yarışmada '
                                      'katılımcı listesine otomatik ekleneceksin.',
                                ),
                                const SizedBox(height: 12),
                              ],
                              const _ArenaSectionTitle(
                                icon: Icons.sports_esports_rounded,
                                title: 'YARIŞMA OYUNLARI',
                              ),
                              const SizedBox(height: 8),
                              if (event.active &&
                                  participant &&
                                  completedByMe.length <
                                      event.gameIds.length) ...<Widget>[
                                FilledButton.icon(
                                  onPressed: _playingGameId != null
                                      ? null
                                      : () =>
                                            _playParkour(event, completedByMe),
                                  icon: const Icon(
                                    Icons.play_circle_fill_rounded,
                                  ),
                                  label: Text(
                                    completedByMe.isEmpty
                                        ? '${event.gameIds.length} OYUNLUK PARKURU BAŞLAT'
                                        : 'PARKURA DEVAM ET • ${completedByMe.length}/${event.gameIds.length}',
                                    style: const TextStyle(
                                      fontWeight: FontWeight.w900,
                                    ),
                                  ),
                                  style: FilledButton.styleFrom(
                                    minimumSize: const Size.fromHeight(54),
                                    backgroundColor: const Color(0xFF6CFF9B),
                                    foregroundColor: const Color(0xFF07162E),
                                  ),
                                ),
                                const SizedBox(height: 10),
                              ],
                              ...event.gameIds.map((String gameId) {
                                final _ArenaGameInfo info = _gameInfo(gameId);
                                final bool completed = completedByMe.contains(
                                  gameId,
                                );
                                final ArenaAttempt? attempt = _attemptFor(
                                  attempts,
                                  currentUid,
                                  gameId,
                                );
                                return Padding(
                                  padding: const EdgeInsets.only(bottom: 9),
                                  child: _CompetitionGameCard(
                                    info: info,
                                    completed: completed,
                                    points: attempt?.points,
                                    stars: attempt?.stars,
                                    busy: _playingGameId == gameId,
                                    enabled:
                                        event.active &&
                                        participant &&
                                        !completed &&
                                        gameId == nextGameId,
                                    onPlay: () =>
                                        _playParkour(event, completedByMe),
                                  ),
                                );
                              }),
                              const SizedBox(height: 18),
                              _ArenaSectionTitle(
                                icon: finalResult
                                    ? Icons.emoji_events_rounded
                                    : Icons.leaderboard_rounded,
                                title: finalResult
                                    ? 'KESİN SONUÇLAR'
                                    : 'CANLI SIRALAMA',
                              ),
                              const SizedBox(height: 8),
                              if (standings.isEmpty)
                                const _ArenaInfo(
                                  text: 'Henüz sonuç gönderilmedi.',
                                )
                              else ...<Widget>[
                                if (finalResult)
                                  ChampionCelebrationCard(
                                    key: ValueKey<String>(
                                      'arena_champion_${event.id}',
                                    ),
                                    title: 'MAŞALLAH!',
                                    subtitle:
                                        '${standings.first.displayName} grup şampiyonu 🏆',
                                    celebrate: true,
                                  ),
                                if (finalResult) const SizedBox(height: 10),
                                if (finalResult)
                                  _ArenaReactionPanel(
                                    event: event,
                                    currentUid: currentUid,
                                    busy: _reacting,
                                    onReaction: (String reaction) =>
                                        _sendReaction(event, reaction),
                                  ),
                                if (finalResult) const SizedBox(height: 10),
                                if (finalResult) _Podium(standings: standings),
                                if (finalResult) const SizedBox(height: 10),
                                _StandingsList(
                                  standings: standings,
                                  currentUid: currentUid,
                                ),
                                if (finalResult) const SizedBox(height: 10),
                                if (finalResult)
                                  _ArenaResultShareCard(
                                    event: event,
                                    standings: standings,
                                    currentUid: currentUid,
                                    onShare: () =>
                                        _shareResult(event, standings),
                                  ),
                              ],
                              const SizedBox(height: 16),
                              const _ArenaInfo(
                                icon: Icons.verified_rounded,
                                text:
                                    'Her oyuncu aynı 1. seviye ve ortak parkur '
                                    'düzenini bir kez oynar. Her oyun 100–1.000 '
                                    'Turnuva Puanı verir; ham skorlar birbirine karıştırılmaz.',
                              ),
                              if (event.ownerUid == currentUid &&
                                  event.active) ...<Widget>[
                                const SizedBox(height: 12),
                                OutlinedButton.icon(
                                  onPressed: _finishing
                                      ? null
                                      : () => _finish(event),
                                  icon: const Icon(Icons.flag_rounded),
                                  label: Text(
                                    _finishing ? 'BİTİRİLİYOR...' : 'YARIŞMAYI BİTİR VE SONUCU KESİNLEŞTİR',
                                  ),
                                  style: OutlinedButton.styleFrom(
                                    minimumSize: const Size.fromHeight(52),
                                    foregroundColor: const Color(0xFFFFD93D),
                                  ),
                                ),
                              ],
                              if (event.ownerUid == currentUid &&
                                  finalResult) ...<Widget>[
                                const SizedBox(height: 12),
                                FilledButton.icon(
                                  key: const ValueKey<String>(
                                    'v9_arena_rematch',
                                  ),
                                  onPressed: _rematching
                                      ? null
                                      : () => _rematch(event),
                                  icon: const Icon(
                                    Icons.replay_circle_filled_rounded,
                                  ),
                                  label: Text(
                                    _rematching
                                        ? 'RÖVANŞ HAZIRLANIYOR...'
                                        : 'AYNI OYUNLARLA RÖVANŞ BAŞLAT',
                                  ),
                                  style: FilledButton.styleFrom(
                                    minimumSize: const Size.fromHeight(54),
                                    backgroundColor: const Color(0xFFFF8A3D),
                                    foregroundColor: const Color(0xFF07162E),
                                    textStyle: const TextStyle(
                                      fontWeight: FontWeight.w900,
                                    ),
                                  ),
                                ),
                              ],
                            ],
                          );
                        },
                  );
                },
          ),
        );
      },
    );
  }
}

