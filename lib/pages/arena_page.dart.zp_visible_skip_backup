              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: <Widget>[
                  if (reactions.isNotEmpty) ...<Widget>[
                    Wrap(
                      spacing: 7,
                      runSpacing: 7,
                      children: reactions
                          .take(8)
                          .map((ArenaReaction item) {
                            return Chip(
                              avatar: Text(item.avatar),
                              label: Text(
                                '${item.displayName}: '
                                '${_labels[item.reaction] ?? item.reaction}',
                              ),
                            );
                          })
                          .toList(growable: false),
                    ),
                    const SizedBox(height: 10),
                  ],
                  const Text(
                    'KISA MESAJ GÖNDER',
                    style: TextStyle(
                      color: Colors.white70,
                      fontWeight: FontWeight.w900,
                      fontSize: 11,
                      letterSpacing: 0.8,
                    ),
                  ),
                  const SizedBox(height: 8),
                  Wrap(
                    spacing: 7,
                    runSpacing: 7,
                    children: _labels.entries
                        .map((MapEntry<String, String> item) {
                          return ChoiceChip(
                            label: Text(item.value),
                            selected: mine == item.key,
                            onSelected: busy
                                ? null
                                : (_) {
                                    unawaited(onReaction(item.key));
                                  },
                          );
                        })
                        .toList(growable: false),
                  ),
                ],
              ),
            );
          },
    );
  }
}

