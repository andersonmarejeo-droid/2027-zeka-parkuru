<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ZekaParkuruLaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/zeka_parkuru_launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/zeka_parkuru_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/zp_native_splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/zeka_parkuru_splash_background</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/zeka_parkuru_splash_background</item>
        <item name="android:navigationBarColor">@color/zeka_parkuru_splash_background</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
